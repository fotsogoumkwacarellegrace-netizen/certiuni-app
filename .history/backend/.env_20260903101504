# -------------------------------------------------------------
# Configuration Générale du Serveur
# -------------------------------------------------------------
NODE_ENV=development
PORT=3000

# -------------------------------------------------------------
# URLs Frontend (Angular) & Vérification Publique
# -------------------------------------------------------------
FRONTEND_URL=http://localhost:4200
PUBLIC_VERIFY_URL=http://localhost:4200/verify

# -------------------------------------------------------------
# Base de Données PostgreSQL (Docker)
# -------------------------------------------------------------
DATABASE_URL="postgresql://<USER>:<PASSWORD>@localhost:5432/certiuni_db?schema=public"

# -------------------------------------------------------------
# Cache & Queues Redis (Docker)
# -------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379

# -------------------------------------------------------------
# Sécurité & Tokens JWT
# -------------------------------------------------------------
JWT_SECRET="certiuni_super_secret_jwt_key_2026_dev_mode"
JWT_ACCESS_SECRET="certiuni_access_token_secret_key_2026_32bytes"
JWT_REFRESH_SECRET="certiuni_refresh_token_secret_key_2026_32bytes"

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# -------------------------------------------------------------
# Service d'Envoi d'Emails (Nodemailer / Mailtrap)
# -------------------------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=votre_user_mailtrap
SMTP_PASS=votre_password_mailtrap
MAIL_FROM=noreply@certiuni.app

# -------------------------------------------------------------
# Stockage S3 & Limites de Fichiers
# -------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
UPLOAD_MAX_FILE_SIZE=10485760