{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@prisma/*": ["src/prisma/*"],
      "@auth/*": ["src/auth/*"],
      "@modules/*": ["src/modules/*"]
    },
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    ".history",
    "src/app.module.ts",
    "src/auth/**",
    "src/certificates/**",
    "src/public-verify/**",
    "src/controllers/**",
    "src/jobs/**",
    "src/lib/**",
    "src/server.js"
  ]
}
