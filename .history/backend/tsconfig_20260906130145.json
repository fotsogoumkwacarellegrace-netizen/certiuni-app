{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@prisma/*": ["src/prisma/*"],
      "@auth/*": ["src/modules/auth/*"],
      "@common/*": ["src/common/*"],
    }
    "rootDir": "src",
    "outDir": "dist",
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true,
    "removeComments": true,
    "sourceMap": true,
    "incremental": true,
    "paths": {
      "@prisma/*": ["src/prisma/*"],
      "@auth/*": ["src/auth/*"],
      "@modules/*": ["src/modules/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    ".history",
    "test",
    "**/*spec.ts"
  ]
}