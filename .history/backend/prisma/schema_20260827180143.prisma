// ==============================================================================
// CONFIGURATION DU GENERATEUR ET DE LA BASE DE DONNEES
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================================================
// ENUMS (TYPES ENUMERES)
// ==============================================================================

enum RoleEnum {
  SUPER_ADMIN
  ADMIN_UNIV
  ISSUER
}

enum CertificateStatus {
  VALID
  REVOKED
}

enum BatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum VerificationResult {
  VALID
  REVOKED
  INVALID
}

// ==============================================================================
// MODELES DE DONNEES (8 TABLES)
// ==============================================================================

/// 1. Table des universités (Tenants)
model University {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(255)
  code         String        @unique @db.VarChar(50)
  domain       String        @unique @db.VarChar(255)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  users        User[]
  students     Student[]
  certificates Certificate[]
  batches      Batch[]

  @@map("universities")
}

/// 2. Table des comptes d'accès (Comptes d'utilisateurs et agents)
model User {
  id           String        @id @default(uuid()) @db.Uuid
  universityId String?       @map("university_id") @db.Uuid
  email        String        @unique @db.VarChar(255)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  role         RoleEnum      @default(ISSUER)
  mfaSecret    String?       @map("mfa_secret") @db.VarChar(255)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  university   University?   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  revocations  Revocation[]  @relation("RevokedByUser")
  batches      Batch[]       @relation("CreatedByUser")
  auditLogs    SecurityAuditLog[]

  @@map("users")
}

/// 3. Table des étudiants (Bénéficiaires des diplômes)
model Student {
  id              String        @id @default(uuid()) @db.Uuid
  universityId    String        @map("university_id") @db.Uuid
  studentIdNumber String        @map("student_id_number") @db.VarChar(100)
  firstName       String        @map("first_name") @db.VarChar(100)
  lastName        String        @map("last_name") @db.VarChar(100)
  email           String        @db.VarChar(255)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  university      University    @relation(fields: [universityId], references: [id], onDelete: Cascade)
  certificates    Certificate[]

  // Unicité du matricule par université
  @@unique([universityId, studentIdNumber])
  @@map("students")
}

/// 4. Table des diplômes (Registre central des diplômes émises)
model Certificate {
  id           String            @id @default(uuid()) @db.Uuid
  universityId String            @map("university_id") @db.Uuid
  studentId    String            @map("student_id") @db.Uuid
  hashSha256   String            @unique @map("hash_sha256") @db.Char(64)
  degreeType   String            @map("degree_type") @db.VarChar(100)
  fieldOfStudy String            @map("field_of_study") @db.VarChar(255)
  issueDate    DateTime          @map("issue_date") @db.Timestamptz
  status       CertificateStatus @default(VALID)
  pdfS3Key     String            @map("pdf_s3_key") @db.VarChar(512)
  qrCodeUrl    String            @map("qr_code_url") @db.VarChar(512)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  university   University        @relation(fields: [universityId], references: [id], onDelete: Cascade)
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  revocation   Revocation?
  verifications VerificationLog[]

  // Indexation B-Tree prioritaire pour la vérification instantanée
  @@index([hashSha256])
  @@map("certificates")
}

/// 5. Table des révocations (Historique des révocations administratives)
model Revocation {
  id            String      @id @default(uuid()) @db.Uuid
  certificateId String      @unique @map("certificate_id") @db.Uuid
  revokedBy     String      @map("revoked_by") @db.Uuid
  reason        String      @db.Text
  revokedAt     DateTime    @default(now()) @map("revoked_at") @db.Timestamptz

  // Relations
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  user          User        @relation("RevokedByUser", fields: [revokedBy], references: [id], onDelete: Restrict)

  @@map("revocations")
}

/// 6. Table des ingestions de masse (Traitements par lots de diplômes)
model Batch {
  id               String      @id @default(uuid()) @db.Uuid
  universityId     String      @map("university_id") @db.Uuid
  createdBy        String      @map("created_by") @db.Uuid
  fileName         String      @map("file_name") @db.VarChar(255)
  totalRecords     Int         @map("total_records")
  processedRecords Int         @default(0) @map("processed_records")
  status           BatchStatus @default(PENDING)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  university       University  @relation(fields: [universityId], references: [id], onDelete: Cascade)
  user             User        @relation("CreatedByUser", fields: [createdBy], references: [id], onDelete: Restrict)

  @@map("batches")
}

/// 7. Table des logs de vérification (Audit des vérifications publiques)
model VerificationLog {
  id            String             @id @default(uuid()) @db.Uuid
  certificateId String?            @map("certificate_id") @db.Uuid
  searchedHash  String             @map("searched_hash") @db.Char(64)
  ipAddress     String             @map("ip_address") @db.VarChar(45)
  userAgent     String             @map("user_agent") @db.Text
  result        VerificationResult
  verifiedAt    DateTime           @default(now()) @map("verified_at") @db.Timestamptz

  // Relations
  certificate   Certificate?       @relation(fields: [certificateId], references: [id], onDelete: SetNull)

  @@map("verification_logs")
}

/// 8. Table d'audit de sécurité (Journal d'événements cryptographiques & accès)
model SecurityAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  details    Json     @db.JsonB
  ipAddress  String   @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("security_audit_logs")
}