datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  SUPER_ADMIN
  UNIV_ADMIN
  ISSUER
  VERIFIER
  STUDENT
}

enum CertificateStatus {
  PENDING
  ISSUED
  FAILED
  REVOKED
}

enum AuditAction {
  USER_LOGIN
  USER_LOGOUT
  USER_CREATED
  USER_UPDATED
  UNIVERSITY_CREATED
  UNIVERSITY_UPDATED
  CERTIFICATE_ISSUED
  CERTIFICATE_REVOKED
  VERIFICATION_SUCCESS
  VERIFICATION_FAILED
  REQUEST_CREATED
  REQUEST_UPDATED
}

enum PaymentMethod {
  STRIPE
  PAYPAL
  ORANGE_MONEY
  MTN_MOMO
  BANK_TRANSFER
  CASH
  FREE
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
  FREE
  UNPAID
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  COMPLETED
}

// ==========================================
// 1. GESTION DES ACCÈS & RÔLES (RBAC)
// ==========================================

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(100)
  description String?          @db.VarChar(255)
  permissions RolePermission[]
  users       UserRoleLink[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100) // Ex: document:create, request:approve
  description String?          @db.VarChar(255)
  roles       RolePermission[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleLink {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserUniversity {
  userId       String     @db.Uuid
  universityId String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@id([userId, universityId])
  @@map("user_universities")
}

/// Utilisateurs de la plateforme
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  firstName    String   @db.VarChar(100)
  lastName     String   @db.VarChar(100)
  role         UserRole @default(ISSUER)
  isActive     Boolean  @default(true)

  // Authentification Double Facteur (MFA/TOTP)
  isMfaEnabled Boolean @default(false)
  mfaSecret    String? @db.VarChar(255)

  // Tenant facultatif (SuperAdmin n'a pas d'université rattachée)
  universityId String?     @db.Uuid
  university   University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  issuedCertificates Certificate[]    @relation("IssuedBy")
  auditLogs          AuditLog[]
  userRoles          UserRoleLink[]
  userUniversities   UserUniversity[]
  handledRequests    Request[]        @relation("HandledRequests")
  studentProfile     Student?
  notifications      Notification[]

  @@index([email])
  @@index([universityId])
  @@map("users")
}

// ==========================================
// 2. ÉTABLISSEMENTS & STRUCTURE ACADÉMIQUE
// ==========================================

/// Établissements d'enseignement (Multi-Tenancy)
model University {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(255)
  code       String   @unique @db.VarChar(50) // Code institutionnel unique
  logoUrl    String?  @db.VarChar(1024)
  website    String?  @db.VarChar(255)
  isVerified Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  users            User[]
  certificates     Certificate[]
  auditLogs        AuditLog[]
  templates        CertificateTemplate[]
  userUniversities UserUniversity[]
  programs         Program[]
  academicLevels   AcademicLevel[]
  academicYears    AcademicYear[]
  students         Student[]
  services         Service[]
  pricings         Pricing[]
  notifications    Notification[]

  @@map("universities")
}

model Program {
  id           String     @id @default(uuid()) @db.Uuid
  code         String     @db.VarChar(50)
  name         String     @db.VarChar(255)
  description  String?    @db.Text
  universityId String     @db.Uuid
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  students     Student[]
  certificates Certificate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, universityId])
  @@map("programs")
}

model AcademicLevel {
  id           String     @id @default(uuid()) @db.Uuid
  code         String     @db.VarChar(50) // Ex: L1, L3, M2
  name         String     @db.VarChar(100) // Ex: Licence 1, Master 2
  universityId String     @db.Uuid
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  students     Student[]
  certificates Certificate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, universityId])
  @@map("academic_levels")
  enrollments Enrollment[]
}

model AcademicYear {
  id           String     @id @default(uuid()) @db.Uuid
  year         String     @db.VarChar(20) // Ex: 2025-2026
  universityId String     @db.Uuid
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  students     Student[]
  certificates Certificate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, universityId])
  @@map("academic_years")
}

// ==========================================
// 3. ÉTUDIANTS
// ==========================================

model Student {
  id        String  @id @default(uuid()) @db.Uuid
  matricule String  @db.VarChar(50)
  firstName String  @db.VarChar(100)
  lastName  String  @db.VarChar(100)
  email     String? @db.VarChar(255)
  phone     String? @db.VarChar(50)

  userId String? @unique @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  universityId String     @db.Uuid
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  programId String  @db.Uuid
  program   Program @relation(fields: [programId], references: [id], onDelete: Restrict)

  levelId       String        @db.Uuid
  academicLevel AcademicLevel @relation(fields: [levelId], references: [id], onDelete: Restrict)

  yearId       String       @db.Uuid
  academicYear AcademicYear @relation(fields: [yearId], references: [id], onDelete: Restrict)

  certificates Certificate[]
  requests     Request[]
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matricule, universityId])
  @@index([universityId])
  @@index([programId])
  @@map("students")
}

model Enrollment {
  id              String        @id @default(uuid()) @db.Uuid
  status          String        @default("PENDING") @db.VarChar(50) // Ex: PENDING, ACTIVE, COMPLETED, CANCELLED
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  studentId       String        @db.Uuid
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  programId       String        @db.Uuid
  program         Program       @relation(fields: [programId], references: [id], onDelete: Restrict)

  academicLevelId String        @db.Uuid
  academicLevel   AcademicLevel @relation(fields: [academicLevelId], references: [id], onDelete: Restrict)

  academicYearId  String        @db.Uuid
  academicYear    AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  @@unique([studentId, academicYearId])
  @@map("enrollments")
}

// ==========================================
// 4. DOCUMENTS, DIPLÔMES ET FICHIERS
// ==========================================

model DocumentType {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(50) // Ex: DIPLOMA, TRANSCRIPT
  name        String  @db.VarChar(100)
  description String? @db.Text

  certificates Certificate[]
  services     Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("document_types")
}

model Document {
  id        String   @id @default(uuid())
  hash      String   @unique
  qrData    String?
  createdAt DateTime @default(now())
}

/// Diplômes, Actes et Certificats numériques
model Certificate {
  id               String @id @default(uuid()) @db.Uuid
  publicIdentifier String @unique @db.VarChar(100)
  canonicalHash    String @unique @db.VarChar(64)

  paymentState String @default("UNPAID") @db.VarChar(50)
  metadataJson Json?

  // Données de l'étudiant
  studentIdentifier String @db.VarChar(50)
  studentFirstName  String @db.VarChar(100)
  studentLastName   String @db.VarChar(100)
  studentEmail      String @db.VarChar(255)

  // Mentions académiques
  degreeTitle  String   @db.VarChar(255)
  fieldOfStudy String   @db.VarChar(200)
  grade        String?  @db.VarChar(50)
  issueDate    DateTime

  // Fichier PDF & Statut
  pdfUrl String?           @db.VarChar(1024)
  pdfKey String?           @db.VarChar(512)
  status CertificateStatus @default(PENDING)

  // Métadonnées de révocation
  revokedAt        DateTime?
  revocationReason String?   @db.Text

  // Traçabilité & Relations Structurelles
  universityId String     @db.Uuid
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  issuedById String @db.Uuid
  issuedBy   User   @relation("IssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)

  typeId       String?       @db.Uuid
  documentType DocumentType? @relation(fields: [typeId], references: [id], onDelete: SetNull)

  studentId String?  @db.Uuid
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  programId String?  @db.Uuid
  program   Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  levelId       String?        @db.Uuid
  academicLevel AcademicLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)

  yearId       String?       @db.Uuid
  academicYear AcademicYear? @relation(fields: [yearId], references: [id], onDelete: SetNull)

  templateId String?              @db.Uuid
  template   CertificateTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  files            File[]
  verificationLogs VerificationLog[]
  payments         Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publicIdentifier])
  @@index([canonicalHash])
  @@index([studentIdentifier])
  @@index([universityId])
  @@index([studentId])
  @@map("certificates")
}

model File {
  id       String @id @default(uuid()) @db.Uuid
  fileName String @db.VarChar(255)
  fileUrl  String @db.VarChar(1024)
  mimeType String @db.VarChar(100)
  fileSize Int

  certificateId String?      @db.Uuid
  certificate   Certificate? @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  requestId String?  @db.Uuid
  request   Request? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([certificateId])
  @@index([requestId])
  @@map("files")
}

// ==========================================
// 5. SERVICES, TARIFS & REQUÊTES
// ==========================================

model Service {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @db.VarChar(50) // Ex: REISSUE, CERTIFIED_COPY
  name        String  @db.VarChar(100)
  description String? @db.Text

  universityId String     @db.Uuid
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  documentTypeId String       @db.Uuid
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)

  pricings Pricing[]
  requests Request[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, universityId])
  @@map("services")
}

model Pricing {
  id       String  @id @default(uuid()) @db.Uuid
  amount   Decimal @default(0.00) @db.Decimal(12, 2)
  currency String  @default("XAF") @db.VarChar(10)
  isFree   Boolean @default(false)

  serviceId String  @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  universityId String     @db.Uuid
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId])
  @@index([universityId])
  @@map("pricings")
}

model Request {
  id            String        @id @default(uuid()) @db.Uuid
  requestNumber String        @unique @db.VarChar(100)
  status        RequestStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  // Capture du montant lors de la création de la demande (Snapshot Price)
  amount   Decimal @default(0.00) @db.Decimal(12, 2)
  currency String  @default("XAF") @db.VarChar(10)

  notes String? @db.Text

  studentId String  @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  serviceId String  @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  handledById String? @db.Uuid
  handledBy   User?   @relation("HandledRequests", fields: [handledById], references: [id], onDelete: SetNull)

  attachedFiles File[]
  payments      Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([serviceId])
  @@index([status])
  @@map("requests")
}

// ==========================================
// 6. LOGS & AUTRES MODULES
// ==========================================

model VerificationLog {
  id         String   @id @default(uuid()) @db.Uuid
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(512)
  verifiedAt DateTime @default(now())

  certificateId String      @db.Uuid
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([certificateId])
  @@map("verification_logs")
}

/// Registre d'audit immutable de sécurité
model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  action    AuditAction
  ipAddress String?     @db.VarChar(45)
  userAgent String?     @db.VarChar(512)
  metadata  Json?

  // Relations
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  universityId String?     @db.Uuid
  university   University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([universityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  universityId String?     @db.Uuid
  university   University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  type      String  @db.VarChar(50)
  title     String? @db.VarChar(255)
  message   String  @db.Text
  isRead    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("notifications")
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  requestId String  @db.Uuid
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  certificateId String?      @db.Uuid
  certificate   Certificate? @relation(fields: [certificateId], references: [id], onDelete: SetNull)

  studentId String?  @db.Uuid
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  amount               Decimal       @db.Decimal(12, 2)
  currency             String        @default("XAF") @db.VarChar(10)
  provider             PaymentMethod
  status               PaymentStatus @default(PENDING)
  transactionId        String?       @unique @db.VarChar(255)
  transactionReference String?       @unique @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId])
  @@index([certificateId])
  @@index([studentId])
  @@map("payments")
}

model CertificateTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  layoutConfig Json

  universityId String     @db.Uuid
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  certificates Certificate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([universityId])
  @@map("certificate_templates")
}