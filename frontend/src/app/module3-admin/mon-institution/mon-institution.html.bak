<div class="institution-page">

  <!-- En-tête -->
  <header class="page-header">

    <div>
      <h1>Mon institution</h1>
      <p>
        Informations officielles et documents de votre institution.
      </p>
    </div>

    <button
      type="button"
      class="btn-edit"
      (click)="modifierInstitution()"
    >
      <span class="material-icons">edit</span>
      <span>Modifier</span>
    </button>

  </header>


  <!-- Informations générales -->
  <section class="institution-card">

    <div class="card-title">
      <h2>Informations générales</h2>
    </div>

    <div class="general-content">

      <!-- Logo -->
      <div class="logo-section">

        <div class="institution-logo">
          <span class="material-icons">account_balance</span>
        </div>

        <button
          type="button"
          class="change-logo"
          (click)="changerLogo()"
        >
          Changer le logo
        </button>

      </div>


      <!-- Informations -->
      <div class="general-info">

        <div class="info-row">
          <span class="info-label">Nom officiel</span>
          <span class="info-value">
            {{ institution.nomOfficiel }}
          </span>
        </div>

        <div class="info-row">
          <span class="info-label">Sigle</span>
          <span class="info-value">
            {{ institution.sigle }}
          </span>
        </div>

        <div class="info-row">
          <span class="info-label">Type d'établissement</span>
          <span class="info-value">
            {{ institution.type }}
          </span>
        </div>

        <div class="info-row">
          <span class="info-label">Date de création</span>
          <span class="info-value">
            {{ institution.dateCreation }}
          </span>
        </div>

        <div class="info-row">
          <span class="info-label">Statut</span>

          <span class="status-badge">
            <span class="material-icons">verified</span>
            {{ institution.statut }}
          </span>
        </div>

      </div>

    </div>

  </section>


  <!-- Coordonnées + représentant légal -->
  <div class="two-columns">

    <!-- Coordonnées -->
    <section class="institution-card">

      <div class="card-title">
        <h2>Coordonnées</h2>
      </div>

      <div class="details-list">

        <div class="detail-row">
          <span class="detail-label">Domaine DNS</span>

          <div class="detail-value-with-badge">
            <span>{{ institution.domaineDns }}</span>

            
          </div>
        </div>

        <div class="detail-row">
          <span class="detail-label">Adresse</span>
          <span class="detail-value">
            {{ institution.adresse }}
          </span>
        </div>

        <div class="detail-row">
          <span class="detail-label">Téléphone</span>
          <span class="detail-value">
            {{ institution.telephone }}
          </span>
        </div>

        <div class="detail-row">
          <span class="detail-label">Email</span>
          <span class="detail-value">
            {{ institution.email }}
          </span>
        </div>

        <div class="detail-row">
          <span class="detail-label">Site web</span>
          <span class="detail-value">
            {{ institution.siteWeb }}
          </span>
        </div>

      </div>

    </section>


    <!-- Représentant légal -->
    <section class="institution-card">

      <div class="card-title">
        <h2>Représentant légal</h2>
      </div>

      <div class="details-list">

        <div class="detail-row">
          <span class="detail-label">Nom complet</span>
          <span class="detail-value">
            {{ institution.representant }}
          </span>
        </div>

        <div class="detail-row">
          <span class="detail-label">Fonction</span>
          <span class="detail-value">
            {{ institution.fonction }}
          </span>
        </div>

        <div class="detail-row">
          <span class="detail-label">Téléphone</span>
          <span class="detail-value">
            {{ institution.telephoneRepresentant }}
          </span>
        </div>

        <div class="detail-row">
          <span class="detail-label">Email</span>
          <span class="detail-value">
            {{ institution.emailRepresentant }}
          </span>
        </div>

        <div class="detail-row signature-row">

          <span class="detail-label">Signature numérique</span>

          <button
            type="button"
            class="signature-button"
            (click)="voirSignature()"
          >
            <span class="material-icons">draw</span>
            Voir la signature
          </button>

        </div>

      </div>

    </section>

  </div>


  <!-- Documents officiels -->
  <section class="institution-card documents-card">

    <div class="card-title">
      <h2>Documents officiels</h2>
    </div>


    <div class="documents-list">

      @for (document of documents; track document.fichier) {

        <div class="document-row">

          <div class="document-information">

            <div class="document-icon">
              <span class="material-icons">description</span>
            </div>

            <div class="document-name">
              <span class="document-title">
                {{ document.nom }}
              </span>

              <span class="document-file">
                {{ document.fichier }}
              </span>
            </div>

          </div>


          <div class="document-date">
            Téléversé le {{ document.dateUpload }}
          </div>


          <div class="document-actions">

            <button
              type="button"
              class="icon-button"
              title="Télécharger"
              aria-label="Télécharger le document"
              (click)="telechargerDocument(document)"
            >
              <span class="material-icons">download</span>
            </button>

            <button
              type="button"
              class="icon-button"
              title="Voir"
              aria-label="Voir le document"
              (click)="voirDocument(document)"
            >
              <span class="material-icons">visibility</span>
            </button>

          </div>

        </div>

      }

    </div>

  </section>


  <!-- Navigation -->
  <div class="page-navigation">


  </div>

</div>