{
  "name": "backend",
  "version": "3.0.0",
  "description": "Backend API de CertiUni — Plateforme de certification de diplômes universitaires",
  "main": "dist/src/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"tests/**/*.ts\"",
    "start": "nest start",
    "dev": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "seed": "tsx prisma/seeds/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test": "jest --config jest.unit.config.js --silent",
    "test:watch": "jest --watch",
    "test:unit": "jest --config jest.unit.config.js --silent",
    "test:unit:watch": "jest --config jest.unit.config.js --watch",
    "test:unit:cov": "jest --config jest.unit.config.js --coverage",
    "test:integration": "jest --config jest.integration.config.js --silent",
    "test:integration:watch": "jest --config jest.integration.config.js --watch",
    "test:cov": "jest --config jest.unit.config.js --coverage",
    "test:cov:watch": "jest --config jest.unit.config.js --coverage --watch",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --passWithNoTests",
    "test:e2e:watch": "jest --config ./test/jest-e2e.json --watch",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "lint:check": "eslint src/**/*.ts tests/**/*.ts --max-warnings=0",
    "security:audit": "npm audit --audit-level=moderate",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e -- --passWithNoTests",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "prisma:status": "prisma migrate status",
    "prisma:validate": "prisma validate",
    "security:check": "npm audit --audit-level=high"
  },
  "prisma": {
    "seed": "tsx prisma/seeds/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "@google/genai": "^2.21.0",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/terminus": "^10.2.0",
    "@nestjs/throttler": "^5.0.0",
    "@nestjs/typeorm": "^10.0.2",
    "@prisma/client": "^5.22.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.3.0",
    "bullmq": "^6.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "handlebars": "^4.7.10",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "puppeteer": "^22.10.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "speakeasy": "^2.0.0",
    "uuid": "^10.0.0",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^4.7.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "@types/passport": "^1.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^29.7.0",
    "prettier": "^3.4.0",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
