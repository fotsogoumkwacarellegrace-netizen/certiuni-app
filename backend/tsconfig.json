{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@prisma/*": ["src/prisma/*"],
      "@auth/*": ["src/common/*"],
      "@common/*": ["src/common/*"],
      "@config/*": ["src/config/*"],
      "@utils/*": ["src/common/utils/*"],
      "@modules/*": ["src/modules/*"],
      "@services/*": ["src/services/*"]
    },
    "rootDir": ".",
    "outDir": "dist/src",
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "5.0",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true,
    "removeComments": true,
    "sourceMap": true,
    "incremental": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "test/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".history"
  ]
}