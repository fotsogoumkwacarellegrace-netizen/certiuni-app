# REQUIS MVP
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_ACCESS_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_64_CHARACTER_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=REPLACE_WITH_A_RANDOM_64_CHARACTER_KEY
QR_SECRET_KEY=REPLACE_WITH_A_RANDOM_64_CHARACTER_KEY
PUBLIC_VERIFY_URL=http://localhost:3000/api/v1/certificates/verify
APP_URL=http://localhost:4200
FRONTEND_URL=http://localhost:4200
STRIPE_SECRET_KEY=sk_test_REPLACEWITHREALTESTKEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACEWITHREALTESTSECRET
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM=notifications@example.com

# OPTIONNEL (aucun fournisseur optionnel n'est activé pour ce MVP)
REDIS_URL=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=

# EMPLACEMENTS RÉSERVÉS (non implémentés)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=
WEBAUTHN_ORIGIN=
SPECIMEN_MODE_ENABLED=false
