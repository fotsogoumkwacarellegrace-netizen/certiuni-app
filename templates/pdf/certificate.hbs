<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Diplôme Officiel - {{documentNumber}}</title>
    <style>
        /* ==========================================
           CONFIGURATION DE LA PAGE PUPPETEER (A4)
           ========================================== */
        @page {
            size: A4 landscape;
            margin: 0;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            width: 297mm;
            height: 210mm;
            font-family: 'Times New Roman', Times, Georgia, serif;
            color: #1a1a1a;
            background-color: #ffffff;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        /* ==========================================
           CADRES ET BORDURES DÉCORATIVES ACADÉMIQUES
           ========================================== */
        .certificate-wrapper {
            position: relative;
            width: 100%;
            height: 100%;
            padding: 12mm;
        }

        .outer-border {
            width: 100%;
            height: 100%;
            border: 4px solid #1e3a8a; /* Bleu Académique */
            padding: 4mm;
            position: relative;
        }

        .inner-border {
            width: 100%;
            height: 100%;
            border: 1px solid #d97706; /* Or / Ambre */
            padding: 15mm 20mm;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            text-align: center;
            position: relative;
            background: radial-gradient(circle at center, #ffffff 60%, #f8fafc 100%);
        }

        /* Filigrane discret en arrière-plan */
        .watermark {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 320px;
            opacity: 0.04;
            pointer-events: none;
            z-index: 1;
        }

        /* ==========================================
           EN-TÊTE ET INSTITUTION
           ========================================== */
        .header {
            z-index: 2;
            width: 100%;
        }

        .university-logo {
            max-height: 60px;
            margin-bottom: 8px;
        }

        .university-name {
            font-size: 24pt;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #1e3a8a;
            margin: 0;
        }

        .faculty-name {
            font-size: 13pt;
            font-style: italic;
            color: #4b5563;
            margin-top: 4px;
        }

        /* ==========================================
           CORPS DU DIPLÔME
           ========================================== */
        .body-content {
            z-index: 2;
            width: 100%;
            margin: 10px 0;
        }

        .certify-text {
            font-size: 12pt;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: #6b7280;
            margin-bottom: 12px;
        }

        .student-name {
            font-size: 28pt;
            font-weight: bold;
            color: #111827;
            border-bottom: 2px solid #d97706;
            display: inline-block;
            padding-bottom: 4px;
            padding-left: 20px;
            padding-right: 20px;
            margin-bottom: 12px;
        }

        .degree-intro {
            font-size: 13pt;
            color: #374151;
            margin-bottom: 6px;
        }

        .degree-title {
            font-size: 22pt;
            font-weight: bold;
            color: #1e3a8a;
            margin: 6px 0;
        }

        .speciality {
            font-size: 14pt;
            font-style: italic;
            color: #1f2937;
        }

        /* ==========================================
           PIED DE PAGE, SIGNATURES & SÉCURITÉ
           ========================================== */
        .footer {
            z-index: 2;
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-top: 10px;
        }

        .verification-block {
            text-align: left;
            width: 25%;
        }

        .qr-code {
            width: 85px;
            height: 85px;
            border: 1px solid #e5e7eb;
            padding: 3px;
            background-color: #ffffff;
        }

        .doc-number {
            font-family: 'Courier New', Courier, monospace;
            font-size: 8pt;
            color: #6b7280;
            margin-top: 4px;
        }

        .signatures-block {
            width: 50%;
            display: flex;
            justify-content: space-around;
            text-align: center;
        }

        .signature-item {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .signature-title {
            font-size: 10pt;
            font-weight: bold;
            color: #374151;
            margin-bottom: 30px; /* Espace réservé pour la signature manuscrite/image */
        }

        .signature-img {
            max-height: 45px;
            margin-bottom: 5px;
        }

        .signatory-name {
            font-size: 9pt;
            font-weight: bold;
            color: #111827;
        }

        .security-block {
            width: 25%;
            text-align: right;
            font-size: 8pt;
            color: #6b7280;
        }

        .issue-date {
            font-size: 10pt;
            color: #1f2937;
            margin-bottom: 8px;
        }

        .digital-hash-box {
            font-family: 'Courier New', Courier, monospace;
            font-size: 6.5pt;
            word-break: break-all;
            background-color: #f1f5f9;
            padding: 4px;
            border: 1px solid #cbd5e1;
            border-radius: 2px;
            text-align: left;
        }
    </style>
</head>
<body>

    <div class="certificate-wrapper">
        <div class="outer-border">
            <div class="inner-border">

                <!-- Filigrane d'arrière-plan (Logo de l'université ou Sceau) -->
                {{#if universityLogoUrl}}
                <img src="{{universityLogoUrl}}" class="watermark" alt="Watermark" />
                {{/if}}

                <!-- En-tête -->
                <div class="header">
                    {{#if universityLogoUrl}}
                    <img src="{{universityLogoUrl}}" class="university-logo" alt="Logo Université" />
                    {{/if}}
                    <h1 class="university-name">{{universityName}}</h1>
                    {{#if facultyName}}
                    <div class="faculty-name">{{facultyName}}</div>
                    {{/if}}
                </div>

                <!-- Corps de l'attestation / diplôme -->
                <div class="body-content">
                    <div class="certify-text">Atteste que le diplôme de</div>
                    
                    <div class="degree-title">{{degreeTitle}}</div>
                    
                    {{#if speciality}}
                    <div class="speciality">Option / Spécialité : {{speciality}}</div>
                    {{/if}}

                    <div class="degree-intro" style="margin-top: 15px;">A été décerné à</div>
                    
                    <div class="student-name">{{studentFirstName}} {{studentLastName}}</div>
                    
                    <div class="degree-intro">
                        Né(e) le <strong>{{studentBirthDate}}</strong> — Matricule : <strong>{{studentIdNumber}}</strong><br>
                        Pour avoir satisfait à toutes les exigences académiques requises.
                    </div>
                </div>

                <!-- Pied de page, QR Code & Signatures -->
                <div class="footer">
                    
                    <!-- Bloc QR Code & Vérification -->
                    <div class="verification-block">
                        <img src="{{qrCodeDataUrl}}" class="qr-code" alt="QR Code de Vérification" />
                        <div class="doc-number">N° {{documentNumber}}</div>
                    </div>

                    <!-- Bloc Signatures -->
                    <div class="signatures-block">
                        <div class="signature-item">
                            <span class="signature-title">Le Doyen / Directeur</span>
                            {{#if deanSignatureUrl}}
                            <img src="{{deanSignatureUrl}}" class="signature-img" alt="Signature Doyen" />
                            {{/if}}
                            <span class="signatory-name">{{deanName}}</span>
                        </div>
                        <div class="signature-item">
                            <span class="signature-title">Le Recteur / Président</span>
                            {{#if rectorSignatureUrl}}
                            <img src="{{rectorSignatureUrl}}" class="signature-img" alt="Signature Recteur" />
                            {{/if}}
                            <span class="signatory-name">{{rectorName}}</span>
                        </div>
                    </div>

                    <!-- Bloc Date & Empreinte Sécurisée -->
                    <div class="security-block">
                        <div class="issue-date">Fait le : <strong>{{issueDate}}</strong></div>
                        <div>Empreinte numérique SHA-256 :</div>
                        <div class="digital-hash-box">
                            {{digitalHash}}
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>

</body>
</html>